# =================================================================
# AuditEQ 17.0.28 Environment Configuration (Render & GitHub Ready)
# =================================================================

# GROQ_API_KEY: (Optional at boot) - Groq AI API key for Whisper transcription and GPT-OSS auditing.
# Can be supplied as an environment variable or configured dynamically via the web UI / Integrations tab.
GROQ_API_KEY=""

# DATABASE_PATH: (Optional) - Custom persistent storage path for SQLite database.
# On Render Disks or external mounts, set to: /var/data/auditeq_production.db
# Defaults to: .data/auditeq_production.db
DATABASE_PATH=""

# UPLOADS_DIR: (Optional) - Custom directory for ingested call recordings and uploaded files.
# Defaults to: .data/uploads
UPLOADS_DIR=""

# ADMIN_PASSWORD: (Optional) - Initial admin password for the primary 'admin' account.
# Defaults to: AuditEQ@Production2026
ADMIN_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# TATA TELESERVICES ENTERPRISE INTEGRATION
# TATA_API_KEY: Server-side enterprise API authentication key for Tata Smartflo / Teleservices
TATA_API_KEY=""
# TATA_ACCOUNT_ID: (Optional) Tata Enterprise Account / Tenant ID
TATA_ACCOUNT_ID=""
# TATA_API_URL: (Optional) Base URL for Tata Teleservices CDR API
TATA_API_URL="https://api-smartflo.tatateleservices.com/v1"


